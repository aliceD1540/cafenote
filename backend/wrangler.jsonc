/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guestbook-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-09",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cafenote-db",
      "database_id": "7e97af03-1597-4688-9889-71aea1e3dac6"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "COMMENT_CACHE",
      "id": "YOUR_COMMENT_CACHE_KV_ID"
    },
    {
      "binding": "IP_LIMIT",
      "id": "YOUR_IP_LIMIT_KV_ID"
    }
  ],
  "vars": {
    "GEMINI_API_KEY": "AIzaSyBYjdX-1-Ntj0Wzy25B_NJmO5_R6snrrW4",
    "GEMINI_MODEL": "gemini-2.5-flash-lite"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
